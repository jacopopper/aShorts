# Copy to keystore.properties (gitignored) to sign release builds with your Play upload key.
#
# Create the upload key once (keep the file and passwords backed up):
#   keytool -genkeypair -v -keystore ~/keys/ashorts-upload.jks -alias upload \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Then build the Play bundle: ./gradlew :app:bundleRelease
#   -> app/build/outputs/bundle/release/app-release.aab
storeFile=/home/YOU/keys/ashorts-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
